# --- Model backend -------------------------------------------------------
# Server-only: the browser now talks to /api/chat, so these are no longer
# exposed to visitors.
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
# Leave LM_STUDIO_MODEL empty to auto-detect the first chat model LM Studio has
# loaded (embedding/TTS models are skipped). Set it to pin a specific model,
# e.g. LM_STUDIO_MODEL=meta-llama-3.1-8b-instruct
LM_STUDIO_MODEL=
LM_MAX_TOKENS=2048

# --- Clerk ---------------------------------------------------------------
# Used server-side to read and write the subscription entitlement.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- PayPal --------------------------------------------------------------
# When unset, PayPal is hidden from the pricing dialog. Set
# PAYPAL_WEBHOOK_ID too, otherwise webhooks cannot be signature-verified.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
# "live" uses api.paypal.com; anything else uses the sandbox.
PAYPAL_MODE=sandbox

# --- Payzone -------------------------------------------------------------
# SCAFFOLD: confirm these names against your Payzone merchant docs.
# PAYZONE_REFERENCE_SECRET must be set or Payzone stays hidden.
PAYZONE_MERCHANT_ID=
PAYZONE_REFERENCE_SECRET=
PAYZONE_BASE_URL=https://payment.payzone.ma/api/payment

# --- Development ---------------------------------------------------------
# The mock provider stands in for a real gateway so the subscribe -> unlock
# flow can be tested with no credentials. It self-disables in production and
# is never offered while a real provider is configured.
ALLOW_MOCK_PAYMENTS=true
MOCK_PAYMENT_SECRET=dev-only-mock-secret
